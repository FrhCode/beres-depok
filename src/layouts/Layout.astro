---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Beres Depok — Cuci, perbaikan, dan pemasangan AC di Depok",
  description = "Layanan cuci, perbaikan, dan pemasangan AC untuk rumah di Depok. Ceritakan keluhan Anda, lalu sepakati jadwal kunjungan lewat WhatsApp.",
} = Astro.props;
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#183e3b" />
    <link rel="icon" type="image/svg+xml" href="/images/logo.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter+Tight:wght@400;500;600&family=Manrope:wght@500;600;700;800&display=swap"
    />
  </head>
  <body>
    <a class="skip-link" href="#main">Lewati ke konten</a>
    <slot />
  </body>
</html>
