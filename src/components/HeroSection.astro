---
import { site } from "../lib/site";
---

<section class="hero" id="top" aria-labelledby="hero-title">
  <div class="shell">
    <div class="hero-grid">
      <h1 id="hero-title" class="hero-title">Bikin rumah<br />nyaman lagi.</h1>
      <div class="hero-aside" id="cara-pesan">
        <p class="hero-description">
          Cuci, perbaikan, dan pemasangan AC di Depok.<br />
          Ceritakan keluhannya. Kita mulai dari sana.
        </p>
        <a
          class="btn-primary"
          href={site.whatsappUrl}
          target="_blank"
          rel="noopener"
        >
          <span>Konsultasi via WhatsApp</span>
          <span class="arrow" aria-hidden="true">↗</span>
          <span class="sr-only">(membuka WhatsApp di tab baru)</span>
        </a>
      </div>
    </div>

    <div class="hero-media">
      <div class="hero-editorial">
        <h2 class="editorial-heading">
          AC bermasalah?<br />Tidak perlu<br />bingung mulai<br />dari mana.
        </h2>
        <p class="editorial-body">
          Kirim keluhan dan lokasi Anda.<br />
          Tanyakan estimasi biaya serta<br />
          pilihan jadwal kunjungan.
        </p>
      </div>
      <figure class="hero-photo">
        <img
          src="/images/hero-living-room.webp"
          alt="Ruang keluarga dengan sofa abu-abu dan AC di atas jendela."
          width="1600"
          height="1068"
          fetchpriority="high"
        />
      </figure>
    </div>
  </div>
</section>

<style>
  .hero {
    padding-top: 70px;
    padding-bottom: 70px;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 420px;
    column-gap: 10px;
    align-items: start;
  }

  .hero-title {
    font-size: 76px;
    font-weight: 800;
    line-height: 1.2;
    color: var(--text-primary);
    animation: hero-rise 900ms var(--ease) 60ms both;
  }

  .hero-aside {
    padding-top: 26px;
    scroll-margin-top: 24px;
  }

  .hero-description {
    font-size: 16px;
    font-weight: 400;
    line-height: 1.2;
    color: var(--text-hero);
    animation: hero-rise 900ms var(--ease) 230ms both;
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    width: 320px;
    max-width: 100%;
    height: 52px;
    margin-top: 45px;
    padding-inline: 20px;
    border-radius: var(--radius-cta);
    background: var(--bg-inverse);
    color: var(--text-inverse);
    font-size: 15px;
    font-weight: 600;
    line-height: 1.2;
    transition: background-color 160ms var(--ease);
    animation: hero-rise 900ms var(--ease) 400ms both;
  }

  .btn-primary:hover {
    background: var(--bg-inverse-raised);
  }

  .btn-primary:active {
    background: var(--bg-inverse);
  }

  .btn-primary .arrow {
    font-size: 15px;
    line-height: 1;
    transition: transform 200ms var(--ease);
  }

  .btn-primary:hover .arrow {
    transform: translate(2px, -2px);
  }

  .hero-media {
    display: grid;
    grid-template-columns: 484px minmax(0, 1fr);
    column-gap: 31px;
    margin-top: 45px;
  }

  .hero-editorial {
    height: 511px;
    padding-top: 94px;
    border-radius: 24px;
    background: var(--bg-page);
  }

  .editorial-heading {
    font-size: 35px;
    font-weight: 700;
    line-height: 1.2;
    color: var(--text-primary);
  }

  .editorial-body {
    margin-top: 42px;
    font-size: 16px;
    font-weight: 400;
    line-height: 1.2;
    color: var(--text-hero);
  }

  .hero-photo {
    overflow: hidden;
    border-radius: var(--radius-hero);
  }

  .hero-photo img {
    width: 100%;
    height: 561px;
    margin-top: -50px;
    object-fit: cover;
  }

  @media (max-width: 1199px) {
    .hero {
      padding-top: 48px;
      padding-bottom: 56px;
    }

    .hero-grid {
      grid-template-columns: minmax(0, 1fr);
      row-gap: 24px;
    }

    .hero-title {
      font-size: 60px;
    }

    .hero-aside {
      padding-top: 0;
      max-width: 560px;
    }

    .btn-primary {
      margin-top: 28px;
    }

    .hero-media {
      grid-template-columns: minmax(0, 1fr);
      row-gap: 32px;
      margin-top: 40px;
    }

    .hero-editorial {
      height: auto;
      padding-top: 0;
    }

    .hero-editorial .editorial-body {
      margin-top: 24px;
    }

    .hero-photo img {
      height: auto;
      margin-top: 0;
      aspect-ratio: 765 / 511;
    }
  }

  @media (max-width: 767px) {
    .hero {
      padding-top: 36px;
      padding-bottom: 48px;
    }

    .hero-title {
      font-size: 44px;
    }

    .editorial-heading {
      font-size: 30px;
    }
  }

  @keyframes hero-rise {
    from {
      opacity: 0;
      transform: translate3d(0, 20px, 0);
    }

    to {
      opacity: 1;
      transform: none;
    }
  }
</style>
