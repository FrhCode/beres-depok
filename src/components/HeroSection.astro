---
import { site } from "../lib/site";

const steps = [
  { icon: "chat", title: "Ceritakan kondisinya", description: "Kirim keluhan dan foto unit." },
  { icon: "clock", title: "Bahas kebutuhannya", description: "Tanyakan estimasi dan jadwal." },
  { icon: "home", title: "Untuk rumah di Depok", description: "Sampaikan lokasi kunjungan." },
];
---

<section class="hero" id="top" aria-labelledby="hero-title">
  <div class="hero-frame">
    <div class="hero-scene">
      <figure class="hero-photo">
        <img
          src="/images/hero-living-room.webp"
          alt="Ruang keluarga dengan sofa abu-abu dan AC di atas jendela."
          width="1600"
          height="1068"
          fetchpriority="high"
        />
      </figure>
      <div class="hero-copy">
        <p class="hero-eyebrow">Layanan AC untuk rumah di Depok</p>
        <h1 id="hero-title" class="hero-title">AC beres.<br />Rumah<br />nyaman lagi.</h1>
        <p class="hero-description">
          Cuci, perbaikan, dan pemasangan AC.<br />
          Ceritakan keluhannya, kita bantu mulai dari sana.
        </p>
      </div>
      <div class="consultation" id="cara-pesan">
        <h2>Mulai dari<br />keluhan Anda.</h2>
        <p class="consultation-description">
          Kirim keluhan dan lokasi Anda.<br />
          Diskusikan estimasi serta jadwal<br class="desktop-break" /> sebelum kunjungan.
        </p>
        <a class="btn-primary" href={site.whatsappUrl} target="_blank" rel="noopener">
          <span>Konsultasi via WhatsApp</span>
          <span class="arrow" aria-hidden="true">↗</span>
          <span class="sr-only">(membuka WhatsApp di tab baru)</span>
        </a>
        <p class="consultation-footer">Cuci / Perbaikan / Pemasangan</p>
      </div>
    </div>
  </div>
  <div class="shell">
    <ul class="hero-support" aria-label="Cara memulai konsultasi">
      {steps.map((step) => (
        <li>
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            {step.icon === "chat" ? (
              <>
                <path d="M21 11.5a8.4 8.4 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.4 8.4 0 0 1-3.8-.9L3 21l1.9-5.7a8.4 8.4 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.4 8.4 0 0 1 3.8-.9h.5a8.5 8.5 0 0 1 8 8v.5Z" />
                <path d="m8 12 3 3 5-5" />
              </>
            ) : step.icon === "clock" ? (
              <><circle cx="12" cy="12" r="9" /><path d="M12 6v6l4 2" /></>
            ) : (
              <><path d="m2 10 10-7 10 7M4 9v12h16V9" /><path d="M9 21v-8h6v8" /></>
            )}
          </svg>
          <div>
            <h2>{step.title}</h2>
            <p>{step.description}</p>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .hero {
    padding-top: 24px;
    padding-bottom: 128px;
    font-family: var(--font-brand-body);
  }

  .hero-frame {
    max-width: 1440px;
    padding-inline: 40px;
    margin-inline: auto;
  }

  .hero-scene {
    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-columns: minmax(0, 1fr) 356px;
    gap: 40px;
    min-height: 658px;
    padding: 54px 52px 68px;
    overflow: hidden;
    border-radius: 18px;
    color: var(--text-inverse);
  }

  .hero-photo,
  .hero-scene::before {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  .hero-photo {
    z-index: -2;
    overflow: hidden;
  }

  .hero-photo img {
    width: 100%;
    height: calc(100% + 100px);
    margin-top: -50px;
    object-fit: cover;
  }

  .hero-scene::before {
    content: "";
    background: linear-gradient(90deg, rgb(31 37 31 / 94%) 0%, rgb(31 37 31 / 82%) 37%, rgb(31 37 31 / 20%) 78%, rgb(31 37 31 / 6%) 100%);
  }

  .hero-eyebrow {
    font-size: 12px;
    font-weight: 600;
    line-height: 1.35;
    text-transform: uppercase;
  }

  .hero-title {
    margin-top: 41px;
    margin-left: -4px;
    font-size: 80px;
    font-weight: 600;
    line-height: 1.08;
    animation: hero-rise 900ms var(--ease) 60ms both;
  }

  .hero-description {
    margin-top: 54px;
    font-size: 17px;
    line-height: 1.55;
    animation: hero-rise 900ms var(--ease) 230ms both;
  }

  .consultation {
    align-self: start;
    margin-top: 180px;
    min-height: 356px;
    padding: 26px 28px 40px;
    border-radius: 12px;
    background: var(--bg-page);
    color: var(--brand-wordmark);
    scroll-margin-top: 24px;
    animation: hero-rise 900ms var(--ease) 400ms both;
  }

  .consultation h2 {
    font-family: var(--font-brand-display);
    font-size: 30px;
    font-weight: 400;
    line-height: 1.15;
  }

  .consultation-description {
    margin-top: 27px;
    color: var(--brand-muted);
    font-size: 15px;
    line-height: 1.55;
  }

  .btn-primary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    min-height: 54px;
    margin-top: 30px;
    padding: 14px 20px;
    border-radius: 6px;
    background: var(--brand-action);
    color: var(--text-inverse);
    font-size: 15px;
    font-weight: 500;
    line-height: 1.35;
    transition: background-color 160ms var(--ease);
  }

  .btn-primary:hover {
    background: var(--brand-wordmark);
  }

  .arrow {
    font-size: 19px;
    transition: transform 200ms var(--ease);
  }

  .btn-primary:hover .arrow {
    transform: translate(2px, -2px);
  }

  .consultation-footer {
    margin-top: 21px;
    color: var(--brand-muted);
    font-size: 12px;
    line-height: 1.35;
  }

  .hero-support {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 55px;
    margin-top: 32px;
    color: var(--brand-wordmark);
  }

  .hero-support li {
    display: flex;
    align-items: flex-start;
    gap: 16px;
  }

  .hero-support svg {
    flex-shrink: 0;
    margin-top: 6px;
    color: var(--brand-action);
  }

  .hero-support h2 {
    font-family: var(--font-brand-body);
    font-size: 15px;
    font-weight: 500;
    line-height: 1.35;
  }

  .hero-support p {
    margin-top: 8px;
    color: var(--brand-muted);
    font-size: 13px;
    line-height: 1.35;
  }

  @media (max-width: 1199px) {
    .hero { padding-bottom: 80px; }
    .hero-frame { padding-inline: 24px; }
    .hero-scene {
      grid-template-columns: minmax(0, 1fr) 320px;
      gap: 24px;
      min-height: 610px;
      padding: 40px 32px;
    }
    .hero-title { font-size: clamp(48px, 6vw, 72px); }
    .hero-description { margin-top: 40px; }
    .consultation { margin-top: 140px; padding-inline: 24px; }
    .desktop-break { display: none; }
    .hero-support { gap: 24px; }
  }

  @media (max-width: 767px) {
    .hero { padding-top: 16px; padding-bottom: 56px; }
    .hero-frame { padding-inline: 16px; }
    .hero-scene {
      grid-template-columns: minmax(0, 1fr);
      gap: 32px;
      padding: 32px 24px 24px;
    }
    .hero-scene::before {
      background: linear-gradient(180deg, rgb(31 37 31 / 82%), rgb(31 37 31 / 60%));
    }
    .hero-title { margin-top: 32px; margin-left: 0; font-size: clamp(44px, 9vw, 64px); }
    .hero-description { margin-top: 28px; font-size: 16px; }
    .consultation { margin-top: 0; padding: 26px 24px; }
    .consultation-description { margin-top: 20px; }
    .btn-primary { margin-top: 24px; padding-inline: 16px; font-size: 14px; }
    .hero-support { grid-template-columns: minmax(0, 1fr); gap: 24px; }
  }

  @keyframes hero-rise {
    from { opacity: 0; transform: translate3d(0, 20px, 0); }
    to { opacity: 1; transform: none; }
  }
</style>
