---
import { navigation, site } from "../lib/site";
---

<header class="site-header">
  <div class="shell">
    <div class="header-inner">
      <a class="brand" href="#top" aria-label={`${site.name} — kembali ke atas`}>
        <img
          src="/images/aksa-home-logo-horizontal.svg"
          alt={site.name}
          width="660"
          height="130"
          fetchpriority="high"
        />
      </a>
      <nav class="nav" aria-label="Navigasi utama">
        {
          navigation.map((item) => (
            <a href={item.href}>{item.label}</a>
          ))
        }
      </nav>
    </div>
  </div>
</header>

<style>
  .header-inner {
    display: flex;
    align-items: center;
    gap: 24px;
    min-height: 88px;
    padding-block: 22px;
    font-family: var(--font-brand-body);
    color: var(--brand-wordmark);
  }

  .brand img {
    width: 216px;
    height: auto;
  }

  .nav {
    display: flex;
    align-items: center;
    gap: 30px;
    margin-left: 240px;
    font-size: 14px;
    font-weight: 500;
    line-height: 1.35;
    color: var(--brand-wordmark);
  }

  .nav a {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    white-space: nowrap;
  }

  .nav a::after {
    content: "";
    position: absolute;
    inset-inline: 0;
    bottom: 10px;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 240ms var(--ease);
  }

  .nav a:hover {
    color: var(--text-primary);
  }

  .nav a:hover::after,
  .nav a:focus-visible::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  .nav a:focus-visible {
    outline: 2px solid var(--text-primary);
    outline-offset: 3px;
  }

  @media (max-width: 1199px) {
    .nav {
      margin-left: auto;
    }
  }

  @media (max-width: 767px) {
    .header-inner {
      flex-wrap: wrap;
      gap: 8px 20px;
      padding-block: 16px;
      min-height: auto;
    }

    .brand {
      flex-shrink: 0;
    }

    .brand img {
      width: 140px;
      height: auto;
    }

    .nav {
      flex-basis: 100%;
      justify-content: space-between;
      gap: 20px;
      margin-left: 0;
    }
  }

  @media (max-width: 359px) {
    .header-inner {
      gap: 12px;
    }

    .brand img {
      width: 116px;
    }

    .nav {
      gap: 14px;
      font-size: 13px;
    }
  }
</style>
